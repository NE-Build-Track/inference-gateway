# Compose loads .env in this directory. render-config.py loads it without shell evaluation.
VLLM_IMAGE=vllm/vllm-openai:v0.11.0
MODEL_ID=Qwen/Qwen2.5-0.5B-Instruct
SERVED_MODEL_NAME=gateway-model
TOOL_CALL_PARSER=hermes
GPU_MEMORY_UTILIZATION=0.8
HF_TOKEN=
ORCHESTRATOR_BIND=127.0.0.1
ORCHESTRATOR_PORT=8935
# Must be reachable by gateway/signer clients. Use public HTTPS behind a proxy for deployment.
ORCHESTRATOR_SERVICE_URL=http://127.0.0.1:8935
RUNNER_APP=inference/chat/default
RUNNER_CAPACITY=2
# Used only in on-chain mode. These are WHOLESALE rates, unrelated to gateway retail pricing.
RUNNER_PRICE_USD=1
RUNNER_PRICE_UNIT=hour
# On-chain only: registered, active public orchestrator address; never a private key.
ORCHESTRATOR_ADDRESS=
