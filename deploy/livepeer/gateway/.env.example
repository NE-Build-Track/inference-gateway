# Copy to .env, chmod 600. Never commit populated credentials.
IMAGE_REGISTRY=
GATEWAY_PORT=8000
GATEWAY_BACKEND=livepeer
# Registry mode requires CLI-issued keys and configured prices.
GATEWAY_ACCOUNTING_DB=/data/gateway.db
# Legacy shared-key mode requires disabling registry mode explicitly.
# Never combine GATEWAY_API_KEY with GATEWAY_ACCOUNTING_DB.
# GATEWAY_API_KEY=replace-with-a-local-key
GATEWAY_TIMEOUT_SECONDS=300

# Embedded Builder Core routing and server-controlled identity.
GATEWAY_APPLICATION_ID=endpoint-gateway
GATEWAY_ACTOR_ID=shared-application
GATEWAY_MODEL_NAME=qwen3.8-27b
GATEWAY_CHAT_APP=blueclaw/chat/qwen3.8-27b
GATEWAY_UPSTREAM_MODEL=
# Optional JSON array overrides the single-model configuration:
# GATEWAY_MODEL_ROUTES='[{"name":"qwen3.8-27b","app":"blueclaw/chat/qwen3.8-27b","disable_thinking":true}]'
GATEWAY_FIRST_BYTE_TIMEOUT_SECONDS=60
GATEWAY_IDLE_TIMEOUT_SECONDS=60
GATEWAY_MAX_ATTEMPTS=3
GATEWAY_MAX_EVENT_BYTES=1048576
GATEWAY_MAX_OUTPUT_BYTES=8388608
GATEWAY_APPROVED_ORCHESTRATORS=https://orch-us-central.xodeapp.xyz:18935,https://us-central-metrics.speedybird.xyz:28935,https://orch-eu-central.open-pool.com:443,https://hky.eliteencoder.net:8936,https://ai1.eliteencoder.net:8936

# ---- embedded livepeer-builder engine (per_application mode, D3) ---------------------------------
LPB_ENGINE_ID=endpoint-gateway
LPB_ALLOCATION_MODE=per_application
LPB_SIGNER_URL=http://clearinghouse:8937     # the signer shares the clearinghouse network namespace
LPB_BATTERIES_URL=http://clearinghouse:8081
LPB_BATTERIES_TOKEN=                         # deploy/livepeer/gateway/secrets/engine-token
LPB_SHARED_PAYMENT_KEY=                      # lpg_… from deploy/livepeer/gateway/first-run.sh
LPB_SHARED_ALLOCATION_ID=                    # from deploy/livepeer/gateway/first-run.sh
LPB_SECRET_KEY=                              # uv run lpb gen-secret-key (Fernet key for the engine's secret store)
LPB_DEFAULT_CURRENCY=USD
LPB_LOG_JSON=true
